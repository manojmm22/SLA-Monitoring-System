flowchart TB
    U[User] --> B[Browser]
    B --> F[Frontend<br/>React + TypeScript + MUI + Vite]
    F --> API[Flask Backend<br/>Blueprint-based REST API]

    subgraph Auth[Authentication & Access Layer]
        A1[Authentication Module<br/>JWT Login / Refresh / User Session]
        A2[Authorization & RBAC<br/>Roles / Permissions]
    end

    subgraph Core[Application Modules]
        D[Dashboard Module<br/>Analytics & KPI Views]
        M[Monitoring Module<br/>Live service health & metrics]
        S[Services Module<br/>Service inventory & endpoints]
        R[Reports Module<br/>Exportable reports]
        P[Predictions Module<br/>Forecasting & root-cause insights]
        RC[Recovery Module<br/>Self-healing workflows]
        N[Notifications Module<br/>In-app alerts & messages]
    end

    subgraph Agents[Multi-Agent Intelligence Layer]
        G1[Resource Monitoring Agent]
        G2[Response Time Agent]
        G3[SLA Verification Agent]
        G4[Alert Agent]
        G5[Recommendation Agent]
        G6[Report Agent]
        G7[Prediction Agent]
        G8[Recovery Agent]
        G9[Time Analysis Agent]
    end

    subgraph Data[Persistence Layer]
        DB[(SQLite Database<br/>Services / Logs / Alerts / SLA / Users)]
    end

