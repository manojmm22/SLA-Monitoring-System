# ─── Database ──────────────────────────────────────────────────────
# SQLite (default – no setup required):
DATABASE_URL=sqlite:///sla_monitoring.db
# MySQL (uncomment to use instead):
# DATABASE_URL=mysql+pymysql://root:password@localhost/sla_monitoring

# ─── Redis (Optional – for caching) ───────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# ─── Flask ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=your-flask-secret-key-change-in-production

# ─── Email Notifications ──────────────────────────────────────────
SIMULATE_EMAIL=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ─── Monitoring Defaults ──────────────────────────────────────────
DEFAULT_POLLING_INTERVAL=30
DEFAULT_RESPONSE_TIME_THRESHOLD=2000
DEFAULT_CPU_THRESHOLD=80
DEFAULT_RAM_THRESHOLD=85
DEFAULT_DISK_THRESHOLD=90
DEFAULT_AVAILABILITY_THRESHOLD=99.9

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
